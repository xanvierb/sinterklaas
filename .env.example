# Set these only for initial administrator provisioning on an empty database.
SINT_ADMIN_USERNAME=
SINT_ADMIN_PASSWORD=

# PostgreSQL deployment settings, used with SPRING_PROFILES_ACTIVE=postgres.
SINT_DB_URL=jdbc:postgresql://localhost:5432/sinterklaas
SINT_DB_USER=sinterklaas
SINT_DB_PASSWORD=
SINT_BASE_URL=http://localhost:8080
SINT_UPLOAD_DIR=./uploads
SINT_SECURE_COOKIES=false

# Optional product metadata fallback.
TYPESAFE_API_KEY